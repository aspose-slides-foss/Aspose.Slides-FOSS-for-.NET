<Project>

  <!--
    No TargetFramework here, and that absence is deliberate rather than an omission. Every project
    declares `TargetFrameworks`, plural, in its own file. A singular `TargetFramework` set at this
    level silently overrides the plural one below it: the build succeeds, the tests run, and the
    package ships a single framework with nothing reporting that the others were dropped.
  -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!--
    THE RELEASE VERSION IS DEFINED HERE AND NOWHERE ELSE.

    `dotnet pack` reads it, the assembly and file version attributes are generated from it, and the
    workflows ask MSBuild for it — `dotnet msbuild src/Aspose.Slides.Foss -getProperty:Version` —
    rather than parsing it back out of a file name. Parsing the file name is what the CI workflow
    used to do, and it could not survive a change of package identifier: the strip was a literal
    prefix, and a prefix that no longer matches leaves the string untouched instead of failing.

    Editing this property is one step of cutting a release and not the whole of it: README.md,
    SECURITY.md and CHANGELOG.md all currently state that no package has been published. The full
    list is under "Releasing" in CONTRIBUTING.md.

    The scheme is CalVer: <two-digit year>.<month>.<patch>, matching the other language editions of
    this library. The patch component starts at 0 and increments for further releases made inside
    the same calendar month.
  -->
  <PropertyGroup>
    <Version>26.9.0</Version>
  </PropertyGroup>

  <!--
    Identity shared by every project. Only the library is packable, but keeping this here means the
    copyright, the owner and the repository URL are stated once.
  -->
  <PropertyGroup>
    <Authors>Aspose</Authors>
    <Company>Aspose Pty Ltd</Company>
    <Copyright>Copyright (c) 2026 Aspose Pty Ltd</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/aspose-slides-foss/Aspose.Slides-FOSS-for-.NET</PackageProjectUrl>
    <RepositoryUrl>https://github.com/aspose-slides-foss/Aspose.Slides-FOSS-for-.NET.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

</Project>
